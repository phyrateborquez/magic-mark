{
  "name": "magic-mark",
  "version": "0.1.3",
  "private": true,
  "description": "A tiny, ephemeral web text highlighter",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check extension/background.js && node --check scripts/build.mjs && node --check tests/core.test.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --warnings-as-errors",
    "package": "python scripts/package.py",
    "verify": "npm run check && npm test && npm run build && npm run lint:firefox && npm run package && npm run verify:archives",
    "test:firefox": "python scripts/smoke-firefox.py --test-shortcuts",
    "measure:firefox": "python scripts/smoke-firefox.py --performance --test-shortcuts",
    "test:firefox:extended": "python scripts/smoke-firefox.py --extended --test-shortcuts",
    "test:firefox:commands": "python scripts/smoke-firefox.py --test-shortcuts",
    "test:edge:installed": "python scripts/test_chromium_installed.py --edge",
    "test:chrome:installed": "python scripts/test_chromium_installed.py --chrome --lifecycle",
    "test:chrome:minimum": "python scripts/test_chromium_installed.py --minimum",
    "measure:firefox:ab": "python scripts/smoke-firefox.py --ab --test-shortcuts",
    "verify:archives": "python scripts/verify_archives.py"
  },
  "devDependencies": {
    "web-ext": "10.8.0"
  }
}
